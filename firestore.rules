rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This is a single-household, two-person app — there's no per-document
    // ownership model to enforce beyond "is this one of the two family
    // members." Every collection below was confirmed against every
    // collection(db, ...) / doc(db, ...) call in src/pages/Dashboard.js and
    // src/App.js, so this list is exhaustive as of this app's current code.
    function isFamily() {
      return request.auth != null &&
        request.auth.token.email in [
          "nicolasm1410@gmail.com",
          "n.rodriguez2338@gmail.com"
        ];
    }
    match /users/{userId}       { allow read, write: if isFamily(); }
    match /transactions/{docId} { allow read, write: if isFamily(); }
    match /goals/{docId}        { allow read, write: if isFamily(); }
    match /bills/{docId}        { allow read, write: if isFamily(); }
    match /categories/{docId}   { allow read, write: if isFamily(); }
    match /budgetPlans/{docId}  { allow read, write: if isFamily(); }
    match /accounts/{docId}     { allow read, write: if isFamily(); }
    // Not read or written anywhere in the current app — kept in case a
    // future settings feature needs it. Harmless to leave; delete this
    // block if you'd rather rules exactly mirror what's actually used.
    match /settings/{docId}     { allow read, write: if isFamily(); }
  }
}
